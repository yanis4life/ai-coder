<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/export_html"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Page title (e.g. index)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPackageName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="index" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="CSS file name (e.g. styles)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editActivityName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="styles" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="JavaScript file name (e.g. script)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editLayoutName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="script" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Theme color (e.g. #6750A4)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editThemeColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="#6750A4" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnExportXml"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/export_html" />

        <Button
            android:id="@+id/btnExportAar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/export_bundle" />

        <Button
            android:id="@+id/btnExportFigma"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/export_figma" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/export_history"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Exports saved to filesDir/exports/&lt;projectId&gt;/"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
