<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/properties_padding"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchRoundAllPadding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Round all" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Top"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderPaddingTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Right"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderPaddingRight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bottom"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderPaddingBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Left"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderPaddingLeft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/properties_margin"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchRoundAllMargin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Round all" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Top"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMarginTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Right"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMarginRight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bottom"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMarginBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Left"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMarginLeft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
